#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1

PROG=/usr/sbin/tesla-gateway
CONFIG=/etc/tesla-gateway/config.yaml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd sends SIGTERM and waits for the instance; tesla-gateway removes
	# the nft table during its own shutdown path.
	:
}

reload_service() {
	procd_send_signal tesla-gateway '*' HUP
}
