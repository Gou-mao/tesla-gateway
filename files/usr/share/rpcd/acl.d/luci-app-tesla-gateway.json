{
	"luci-app-tesla-gateway": {
		"description": "Grant access to Tesla Gateway status, control and configuration",
		"read": {
			"uci": [ "dhcp", "network" ],
			"file": {
				"/var/run/tesla-gateway/stats.json": [ "read" ],
				"/tmp/run/tesla-gateway/stats.json": [ "read" ],
				"/tmp/tesla-gateway/stats.json": [ "read" ],
				"/etc/tesla-gateway/config.yaml": [ "read" ],
				"/usr/libexec/tg-nft-status": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"file": {
				"/etc/tesla-gateway/config.yaml": [ "write" ],
				"/etc/init.d/tesla-gateway": [ "exec" ],
				"/usr/sbin/tesla-gateway": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		}
	}
}
